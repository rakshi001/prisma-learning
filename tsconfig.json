{
  "compilerOptions": {
    // File layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Runtime & module system (NO ESM headache)
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",

    // Interop so you can use nice imports
    "esModuleInterop": true,

    // Type checking & build sanity
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Useful extras
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
